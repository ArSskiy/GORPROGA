<Page x:Class="GORPROGA.Pages.LogMail"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GORPROGA.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="425" d:DesignWidth="566"
      Title="LogMail">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="14*"/>
            <ColumnDefinition Width="539*"/>
            <ColumnDefinition Width="13*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="47*"/>
            <RowDefinition Height="48*"/>
            <RowDefinition Height="31*"/>
            <RowDefinition Height="48*"/>
            <RowDefinition Height="48*"/>
            <RowDefinition Height="8*"/>
            <RowDefinition Height="40*"/>
            <RowDefinition Height="24*"/>
            <RowDefinition Height="64*"/>
            <RowDefinition Height="67*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Email" FontSize="32" Grid.Column="1" Foreground="White"/>
        <Border CornerRadius="20" Background="#333333" Padding="5" Grid.Row="1" Grid.Column="1" >
            <Grid >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0*"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- Текстовое поле -->
                <TextBox x:Name="MailTB" FontSize="20" Background="#333333"
                 HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                 BorderThickness="0"  Grid.ColumnSpan="2" Foreground="White"/>
            </Grid>
        </Border>

        <TextBlock Text="Пароль" FontSize="32" Grid.Column="1" Grid.Row="3" Foreground="White"/>
        <Border CornerRadius="20" Background="#333333" Padding="5" Grid.Row="4" Grid.Column="1" >
            <Grid >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0*"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>


                <PasswordBox x:Name="loginPB" FontSize="20" Background="#333333"
                 HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                 BorderThickness="0"  Grid.ColumnSpan="2" Foreground="White"/>
            </Grid>
        </Border>
        <TextBlock Text="Не помню пароль" Grid.Column="1" Grid.Row="6"
                   Foreground="#4E4D4D" FontSize="22"/>
        <Button Content="Войти" Background="Orange" Foreground="White" Click="Button_Click"
                    FontSize="40"  BorderThickness="0" Grid.Column="1" Grid.Row="8">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="Orange" CornerRadius="14">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>
        <StackPanel Grid.Column="1" Grid.Row="9">
            <TextBlock Text="Нажимая Войти вы подтверждаете свое согласие c" FontSize="14" Foreground="White" HorizontalAlignment="Center"/>
            <TextBlock Text="Пользовательским соглашением, Политикой конфиденциальности." FontSize="14" Foreground="White" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Page>
