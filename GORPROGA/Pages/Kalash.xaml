            <Button Content="Добавить в корзину" Background="Orange" Foreground="White" 
                    FontSize="40"  BorderThickness="0" Grid.Column="2" Grid.Row="6" HorizontalAlignment="Left" Width="450" Click="Button_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Orange" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

    </Grid>
</Page>
