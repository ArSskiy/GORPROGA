        <Image Source="/Images/GunCrug2.png" Grid.Column="0" Grid.RowSpan="3"/>
        <Image Source="/Images/Kalashnikov.png" Grid.Row="1" Grid.Column="1"/>
        <Grid Grid.Row="2" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="60*"/>
                <RowDefinition Height="47*"/>
                <RowDefinition Height="45*"/>
                <RowDefinition Height="46*"/>
                <RowDefinition Height="38*"/>
                <RowDefinition Height="144*"/>
                <RowDefinition Height="75*"/>
                <RowDefinition Height="17*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*"/>
                <ColumnDefinition Width="5*"/>
                <ColumnDefinition Width="149*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="Пневматическая винтовка Калашников;" FontSize="49" Foreground="White" Grid.ColumnSpan="2"/>
