<Window x:Class="GORPROGA.Windows.GunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GORPROGA.Windows"
        mc:Ignorable="d"
        Title="GunWindow" Height="1024" Width="1440" WindowStartupLocation="CenterScreen">
    <Window.Background>
        <ImageBrush ImageSource="/GORPROGA;component/Images/Desktop.png"/>
    </Window.Background>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="68*"/>
            <RowDefinition Height="48*"/>
            <RowDefinition Height="54*"/>
            <RowDefinition Height="65*"/>
            <RowDefinition Height="29*"/>
            <RowDefinition Height="709*"/>
            <RowDefinition Height="20*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="3" Background="#333333" Orientation="Horizontal">
            <Separator Width="95" Opacity="0"/>
            <TextBlock Text="Первое Ружьё" Foreground="White" FontSize="24"
                       VerticalAlignment="Center" MouseLeftButtonUp="TextBlock_MouseLeftButtonUp"/>
            <Separator Width="300" Opacity="0"/>
            <TextBlock Text="Пневматические винтовки" Foreground="White" FontSize="24"
                       VerticalAlignment="Center" MouseLeftButtonUp="TextBlock_MouseLeftButtonUp_1"/>
            <Separator Width="300" Opacity="0"/>
            <TextBlock Text="Нарезное" Foreground="White" FontSize="24"
                       VerticalAlignment="Center" MouseLeftButtonUp="TextBlock_MouseLeftButtonUp_2"/>
        </StackPanel>

        <Frame Grid.Row="5" Name="GunFrame"/>

        

    </Grid>
</Window>
