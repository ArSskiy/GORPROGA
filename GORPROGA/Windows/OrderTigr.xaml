<Window x:Class="GORPROGA.Windows.OrderTigr"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GORPROGA.Windows"
        mc:Ignorable="d"
        Title="OrderTigr" Height="1024" Width="1440" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="56*"/>
            <ColumnDefinition Width="197*"/>
            <ColumnDefinition Width="46*"/>
            <ColumnDefinition Width="365*"/>
            <ColumnDefinition Width="52*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="140*"/>
            <RowDefinition Height="66*"/>
            <RowDefinition Height="57*"/>
            <RowDefinition Height="61*"/>
            <RowDefinition Height="71*"/>
            <RowDefinition Height="69*"/>
            <RowDefinition Height="58*"/>
            <RowDefinition Height="51*"/>
            <RowDefinition Height="17*"/>
            <RowDefinition Height="89*"/>
            <RowDefinition Height="258*"/>
            <RowDefinition Height="57*"/>
        </Grid.RowDefinitions>
        <Grid.Background>
            <ImageBrush ImageSource="/GORPROGA;component/Images/Desktop.png"/>
        </Grid.Background>
        <TextBlock Grid.Row="1" Grid.Column="1" Text="Корзина" Foreground="White" FontSize="54"/>
        <TextBlock Grid.Row="2" Grid.Column="1" Text="Самовывоз из магазина" Foreground="#D65307" FontSize="50" Grid.ColumnSpan="3"/>
        <TextBlock Grid.Row="3" Grid.Column="1" Text="Напомните клиенту!" Foreground="White" FontSize="54" Grid.ColumnSpan="3"/>
        <TextBlock Grid.Row="4" Grid.Column="1" Text="Для покупки товаров этим способом требуется личное посещение выбранного магазина.
В случае если в заказе присутствует лицензируемая продукция (оружие/патроны/пневматические винтовки и пистолеты с дульной энергией свыше 3 Дж и т.д.), при покупке потребуется предъявить необходимые документы в соответствии с Законом об оружии (паспорт РФ/лицензия установленного образца/разрешение на хранение оружия)." Foreground="White" FontSize="20" TextWrapping="Wrap" Grid.RowSpan="4" Grid.ColumnSpan="2"/>
        <Image Source="/Images/Tigr.png" Grid.Row="9" Grid.Column="1"/>
        <TextBlock Grid.Row="9" Grid.Column="2" Grid.ColumnSpan="2" VerticalAlignment="Center" Text="Тигр 7,62x54R исп. 01; 530 мм; магазин 5-местный" Foreground="White" FontSize="20"/>
        <StackPanel Grid.Row="9" Grid.Column="3" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Width="90" Height="90" Content="-" FontSize="50" Click="Button_Click"/>
            <Separator Width="10" Opacity="0"/>
            <TextBox Width="90" Height="90" Name="AmountGun" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="32"/>
            <Separator Width="10" Opacity="0"/>
            <Button Width="90" Height="90" Content="+" FontSize="50" Click="Button_Click_1"/>
        </StackPanel>

        <Grid Grid.Column="3" Grid.Row="1" Grid.RowSpan="7">
            <Grid.RowDefinitions>
                <RowDefinition Height="61*"/>
                <RowDefinition Height="61*"/>
                <RowDefinition Height="61*"/>
                <RowDefinition Height="61*"/>
                <RowDefinition Height="61*"/>
                <RowDefinition Height="61*"/>
                <RowDefinition Height="61*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="82*"/>
                <ColumnDefinition Width="537*"/>
                <ColumnDefinition Width="111*"/>
            </Grid.ColumnDefinitions>
            <Button Content="Оформить заказ" Width="600" Background="Orange" Foreground="White" 
                    FontSize="36"  BorderThickness="0" Grid.Row="6" Grid.ColumnSpan="3" Click="Button_Click_3">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Orange" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <TextBlock Text="Товар" Grid.Column="1" Foreground="White" FontSize="32" VerticalAlignment="Center"/>
            <TextBlock Text="Скидка" Grid.Column="1" Grid.Row="1" Foreground="White" FontSize="32" VerticalAlignment="Center"/>
            <TextBlock Text="Доставка" Grid.Column="1" Grid.Row="2" Foreground="White" FontSize="32" VerticalAlignment="Center"/>
            <TextBlock Text="Оплата онлайн" Grid.Column="1" Grid.Row="3" Foreground="White" FontSize="32" VerticalAlignment="Center"/>
            <TextBlock Text="Оплата при получении" Grid.Column="1" Grid.Row="4" Foreground="White" FontSize="32" VerticalAlignment="Center"/>

            <TextBox Grid.Column="2" Name="AmountTovar" FontSize="32" Background="{x:Null}" Foreground="White"/>
            <TextBox Grid.Column="2" Grid.Row="1" Text="-0" FontSize="32" Background="{x:Null}" Foreground="White"/>
            <TextBox Grid.Column="2" Grid.Row="2" Text="0" FontSize="32" Background="{x:Null}" Foreground="White"/>
            <TextBox Grid.Column="2" Grid.Row="3" Text="0" FontSize="32" Background="{x:Null}" Foreground="White"/>
            <TextBox Grid.Column="2" Grid.Row="4" Name="Oplata" FontSize="32" Background="{x:Null}" Foreground="White"/>
        </Grid>
        <Grid Grid.Row="10" Grid.Column="1">
            <StackPanel>
                <TextBlock Foreground="White" Text="Получатель" FontSize="26"/>
                <TextBox Height="40" Background="{x:Null}" BorderBrush="#FC5708" Foreground="White" FontSize="24"/>
                <Separator Height="5" Opacity="0"/>
                <TextBlock Foreground="White" Text="Телефон" FontSize="20" />
                <TextBox Height="40" Background="{x:Null}" BorderBrush="#FC5708" Foreground="White" FontSize="24"/>
                <Separator Height="5" Opacity="0"/>
                <TextBlock Foreground="White" Text="Электронная почта" FontSize="20"/>
                <TextBox Height="40" Background="{x:Null}" BorderBrush="#FC5708" Foreground="White" FontSize="24"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="10" Grid.Column="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="338*"/>
                <ColumnDefinition Width="23*"/>
                <ColumnDefinition Width="369*"/>
            </Grid.ColumnDefinitions>
            <CheckBox Grid.Column="1" VerticalAlignment="Center" Background="White" Cursor="Hand" Height="15" Margin="0,121" />
            <StackPanel Grid.Column="2">
                <Separator Height="20" Opacity="0"/>
                <TextBlock Text="Нажимая 'Оформить заказ', вы подтверждаете свое согласие на обработку ваших персональных данных в соответствии c Пользовательским соглашением и Политикой конфиденциальности " Foreground="White" TextWrapping="Wrap" FontSize="18"/>
                <Separator Height="20" Opacity="0"/>
                <Button Content="Назад" Width="265" Background="#333333" Foreground="White" 
                    FontSize="36"  BorderThickness="0" Click="Button_Click_2">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#333333" CornerRadius="12">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
